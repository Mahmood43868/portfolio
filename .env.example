# ─────────────────────────────────────────────────────────────
#  Copy this file to .env.local and fill in what you need.
#  .env.local is gitignored — your keys never get committed.
#  The site RUNS WITHOUT ANY OF THESE; each feature just degrades
#  gracefully until you add the matching key.
# ─────────────────────────────────────────────────────────────

# ── AI chat widget ("Ask about me") ──────────────────────────
# Get one at https://console.anthropic.com → API Keys
# Without it: the widget shows a "not configured yet" message.
ANTHROPIC_API_KEY=

# ── Contact form ─────────────────────────────────────────────
# Get one at https://resend.com (free tier: 3,000 emails/month)
# Without it: the form still succeeds and logs the message to your
# terminal, so you can demo it before signing up.
RESEND_API_KEY=

# Where contact-form messages get delivered. Defaults to the email
# in src/content/profile.ts if you leave this blank.
CONTACT_TO_EMAIL=

# The "from" address. This must be on a domain you control and have verified
# in Resend — a plain Gmail address will NOT work, because otherwise anyone
# could send mail claiming to be you. Resend gives you onboarding@resend.dev
# to test with; once you own a domain, verify it and use "Portfolio <hello@your-domain.com>".
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

